{
  "name": "bookmarker",
  "version": "0.1.29",
  "description": "Capture web URLs as Markdown bookmarks in your Obsidian vault, with og:image preview, AI-proposed tags, and AI-proposed destination subfolder.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsc -p tsconfig.test.json && NODE_PATH=test/stubs node --test node-test-out/test/*.test.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "bookmark"
  ],
  "author": "Stefano Ferri",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.61.0",
    "esbuild": "0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  }
}
